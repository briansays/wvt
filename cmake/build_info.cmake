# Writes the git commit and version tag of the source tree to a C++ file:
# -DSRC=<source dir> -DOUT=<cpp>. It runs at every build (issue #61), so the
# values follow new commits without a new cmake run. The file changes only
# when a value changes, so nothing recompiles otherwise.
set(hash "")
set(tag "")
execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY ${SRC}
  OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(rc OR NOT hash)
  set(hash "unknown")  # no git, or not a git checkout (a source archive)
else()
  # The tag only when it is on this commit: "v1.1-86-g523ac6c" is not a version.
  execute_process(COMMAND git describe --tags --exact-match HEAD WORKING_DIRECTORY ${SRC}
    OUTPUT_VARIABLE tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY ${SRC}
    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(dirty)
    string(APPEND hash "-dirty")
  endif()
endif()
file(WRITE ${OUT}.tmp "// generated by cmake/build_info.cmake\n#include \"build_info.h\"\n"
  "const char* buildGitHash() { return \"${hash}\"; }\n"
  "const char* buildVersionTag() { return \"${tag}\"; }\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
