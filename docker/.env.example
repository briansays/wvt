# Settings for compose.yaml. Copy this file to .env (in this folder) and change
# the values for your computer. Each line can stay commented out: compose.yaml
# then uses the default in brackets.

# The user and group in the container: yours, so that the files in WVT_DATA are
# yours and the X server accepts the connection. Linux: id -u, id -g. (1000)
#WVT_UID=1000
#WVT_GID=1000

# The folder for the recordings, the snapshots and the logs, mounted at /data.
# A relative path is relative to this folder. (./wvt-data)
#WVT_DATA=./wvt-data

# The config folder (wvt.conf, zmq_*.ini), mounted at /opt/wvt/config. (../config:
# the config folder of the repository, the same one that build/wvt uses)
#WVT_CONFIG_DIR=../config

# The X display. Linux: the DISPLAY of your session. macOS with XQuartz:
# host.docker.internal:0. (DISPLAY, else :0)
#WVT_DISPLAY=host.docker.internal:0

# wvt-sdr and wvt-cuda (Linux only):
# The group of the USB devices: stat -c %g /dev/bus/usb/001/001 (46, plugdev)
#WVT_USB_GID=46
# The group of the GPU render node: stat -c %g /dev/dri/renderD128 (44, video)
#WVT_RENDER_GID=44

# The commit that Help > About and the log show: git rev-parse --short HEAD (docker)
#WVT_BUILD_HASH=docker

# The BB60 and Sidekiq backends (refer to "Vendor SDKs" in README.md): build and
# run with the vendor SDKs. The image then has the SDKs in it: do not publish it.
#COMPOSE_FILE=compose.yaml:compose.vendor.yaml
# The SDK folders. A relative path is relative to this folder. ./no-sdk: build
# without that backend.
# (../third_party/sidekiq_sdk/sidekiq_sdk_v4.26.0, the folder with sidekiq_core/)
#WVT_SIDEKIQ_SDK=../third_party/sidekiq_sdk/sidekiq_sdk_v4.26.0
# (../third_party/signal_hound_sdk)
#WVT_SIGNALHOUND_SDK=../third_party/signal_hound_sdk
