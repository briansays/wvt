# Build folders (build/, build-asan/, build-tsan/, build-fuzz/ ...)
/build*/
/cmake-build-*/
docs/build

# Log files that wvt and the build write
*.log

# Recordings and generated test files
*.sigmf-data
*.sigmf-meta
*.wav

# Editor and OS files
.DS_Store
.vscode/
.idea/
*.swp
compile_commands.json
.cache/

# Vendor SDKs unpacked for a local build: not open source, never committed
/third_party/sidekiq_sdk/
/third_party/signal_hound_sdk/

# macOS DS_Store files
.DS_Store

# Obsidian directories
*obsidian*
# The config folder (issue #101): only the examples and the README are tracked
/config/*
!/config/README.md
!/config/*.example
!/config/zmq_gnuradio_sub_cf32.ini
!/config/zmq_raw_pull_ci16.ini
!/config/zmq_example_header.ini
!/config/zmq_wvt_ci16.ini

# Archived documentation pages and the design records (issue #109): kept
# locally, not tracked
/docs/docs-archive/
/docs/design/

# Docker Compose (docker/): your settings and the data folder of the container
/docker/.env
/docker/wvt-data/*
!/docker/wvt-data/.gitkeep
