.PHONY : tools/iqgen.s

# target to generate assembly for a file
tools/iqgen.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/iqgen.dir/build.make CMakeFiles/iqgen.dir/tools/iqgen.cpp.s
.PHONY : tools/iqgen.cpp.s

